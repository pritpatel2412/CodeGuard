Subject: [PATCH 2/3] Test case for GitHub issue 53660 when tf.sparse.split
 when axis is not a scalar

Signed-off-by: Yong Tang <yong.tang.github@outlook.com>
---
 .../kernel_tests/sparse_ops/sparse_split_op_test.py      | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tensorflow/python/kernel_tests/sparse_ops/sparse_split_op_test.py b/tensorflow/python/kernel_tests/sparse_ops/sparse_split_op_test.py
index 28d0fc32875c57..8aaa8279d1cfe6 100644
--- a/tensorflow/python/kernel_tests/sparse_ops/sparse_split_op_test.py
+++ b/tensorflow/python/kernel_tests/sparse_ops/sparse_split_op_test.py
@@ -279,6 +279,15 @@ def testSplitEmpty(self):
     self.assertAllEqual(sparse_splits1[1].values, [])
     self.assertAllEqual(sparse_splits1[1].dense_shape, [4, 3])
 
+  def testInvalidArgumentError(self):
+    # Test case for GitHub issue 53660.
+    axis = [1, 2]
+    with self.assertRaisesRegexp(errors.InvalidArgumentError,
+                                 r'axis should be a scalar'):
+      self.evaluate(
+          sparse_ops.sparse_split(
+              sp_input=self._SparseTensor_4x6(), num_split=3, axis=axis))
+
 
 if __name__ == '__main__':
   test.main()

