+    const canRemoveGrafanaRules = ctx.hasPermissionInMetadata(rulesPermissions.delete, folder);
+
+    return {
+      isEditable: canEditGrafanaRules,
+      isRemovable: canRemoveGrafanaRules,
+      loading,
+    };
+  }, [rule, folderUID, folder, loading]);
