-
-	// Initialize the server before any traffic is served
-	Init(ctx context.Context) error
 }
 
 type ListIterator interface {
@@ -258,6 +255,12 @@ func NewResourceServer(opts ResourceServerOptions) (ResourceServer, error) {
 		}
