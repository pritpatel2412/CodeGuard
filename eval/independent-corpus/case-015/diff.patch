+
+            // Verify we can access protected resources (session is verified)
+            await agent
+                .get('/users/me/')
+                .expectStatus(200);
+
+            // Cleanup: reset the password back to original and disable 2FA
+            configUtils.set('security:staffDeviceVerification', false);
+        });
+    });
 });
